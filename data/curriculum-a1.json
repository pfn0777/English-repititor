        { "en": "bag", "uz": "sumka", "ipa": "bæɡ" },
        { "en": "cup", "uz": "piyola, chashka", "ipa": "kʌp" },
        { "en": "egg", "uz": "tuxum", "ipa": "eɡ" },
        { "en": "hour", "uz": "soat (vaqt oralig'i)", "ipa": "ˈaʊər" },
        { "en": "umbrella", "uz": "soyabon", "ipa": "ʌmˈbrelə" },
        { "en": "new", "uz": "yangi", "ipa": "nuː" },
        { "en": "big", "uz": "katta", "ipa": "bɪɡ" },
        { "en": "small", "uz": "kichik", "ipa": "smɔːl" },
        { "en": "this", "uz": "bu", "ipa": "ðɪs" },
        { "en": "that", "uz": "o'sha, ana u", "ipa": "ðæt" },
        { "en": "here", "uz": "shu yerda", "ipa": "hɪr" }
      ],
      "tasks": ["read", "translate", "build", "listen", "speak", "translate"],
      "lesson": {
        "rule": "Ingliz tilida otlar oldidan artikl ishlatiladi.\n\n1. 'A' va 'An' — noaniq artikllar. Biror narsani birinchi marta aytganda yoki umumiy gapirganda ishlatiladi. \n- 'A' undosh harf bilan boshlanadigan so'zlar oldidan keladi (masalan: a book).\n- 'An' unli harf bilan boshlanadigan so'zlar oldidan keladi (masalan: an apple).\n\n2. 'The' — aniq artikl. Avval aytilgan yoki suhbatdoshga oldindan tanish bo'lgan narsa oldidan ishlatiladi (masalan: The apple is big).\n\nO'zbek tilida artikl yo'q, shuning uchun o'quvchilar ko'pincha 'a' yoki 'the' ni tushirib qoldirishadi. Unutmang: birlikdagi sanaladigan ot artiklsiz ishlatilmaydi!",
        "examples": [
          { "en": "This is a book.", "uz": "Bu kitob.", "note": "'Book' undosh bilan boshlanadi, shuning uchun 'a'." },
          { "en": "I have an apple.", "uz": "Menda olma bor.", "note": "'Apple' unli bilan boshlanadi, shuning uchun 'an'." },
          { "en": "The book is new.", "uz": "O'sha kitob yangi.", "note": "Oldin aytilgan kitob haqida boryapti." },
          { "en": "That is a big house.", "uz": "Ana u katta uy.", "note": "Umumiy bitta uy haqida gap ketmoqda." }
        ],
        "practice": [
          { "q": "I have ___ pen and ___ apple.", "options": [ "a / an", "an / a", "the / the" ], "answer": 0 },
          { "q": "Look at ___ moon! It is bright.", "options": [ "a", "an", "the" ], "answer": 2 },
          { "q": "Which word means 'deraza' in English?", "options": [ "door", "window", "box" ], "answer": 1 }
        ]
      }
    },
