      "tasks": ["read", "translate", "build", "listen", "speak", "translate"],
      "lesson": {
        "rule": "Egalikni bildirish uchun 'have got' ishlatamiz.\nFormula: I/You/We/They + have got (bor) \nHe/She/It + has got (u uchun bor).\n\nO'zbek tilidan farqi: bizda 'mening akam bor' deyiladi, ingliz tilida esa 'I have got a brother' (men akaga egaman) deymiz.\n\nEgalik olmoshlari: my (mening), your (sening), his (uning - erkak), her (uning - ayol), our (bizning), their (ularning). Bular doim egadan oldin keladi: my family (mening oilam).",
        "examples": [
          { "en": "I have got a big family.", "uz": "Mening katta oilam bor.", "note": "Men uchun 'have got' ishlatildi." },
          { "en": "She has got two brothers.", "uz": "Uning ikkita akasi bor.", "note": "U (ayol) uchun 'has got' ishlatiladi." },
          { "en": "This is my mother and father.", "uz": "Bu mening onam va otam.", "note": "'my' - mening." },
          { "en": "His brother is young.", "uz": "Uning akasi yosh.", "note": "'his' - erkak kishi uchun 'uning'." }
        ],
        "practice": [
          { "q": "She ___ got a sister.", "options": [ "have", "has", "is" ], "answer": 1 },
          { "q": "This is ___ father. (uning - ayol uchun)", "options": [ "his", "her", "my" ], "answer": 1 },
          { "q": "My mother and father have got a son and a ___.", "options": [ "daughter", "brother", "friend" ], "answer": 0 }
        ]
      }
    },
